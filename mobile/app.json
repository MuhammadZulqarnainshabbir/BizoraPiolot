{
  "expo": {
    "name": "Bizora Pilot",
    "slug": "bizora-pilot",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bizora.pilot"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.bizora.pilot"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Bizora Pilot uses your photos to attach pictures of customer ID cards.",
          "cameraPermission": "Bizora Pilot uses the camera to photograph customer ID cards."
        }
      ]
    ],
    "scheme": "bizorapilot",
    "experiments": {
      "typedRoutes": false
    }
  }
}
