# Rendered by the nginx image at start-up; ${API_UPSTREAM} comes from the environment.
server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  gzip on;
  gzip_types text/plain text/css application/javascript application/json image/svg+xml;

  # The API lives on the same origin as the app, so no CORS is needed in production.
  location /api/ {
    proxy_pass ${API_UPSTREAM};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  # Hashed build files can be cached for a long time.
  location ~* \.(?:js|css|woff2?|ttf|png|jpg|svg|ico)$ {
    try_files $uri =404;
    expires 1y;
    add_header Cache-Control "public, immutable";
  }

  # Universal link file for the mobile app (public/.well-known): no extension, must be JSON.
  location = /.well-known/apple-app-site-association {
    default_type application/json;
    try_files $uri =404;
  }

  # Angular routes (e.g. /partnerdashboard/inventory) are handled by the app.
  location / {
    try_files $uri $uri/ /index.html;
    add_header Cache-Control "no-cache";
  }
}
