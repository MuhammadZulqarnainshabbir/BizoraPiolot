PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/electrohub
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
CLIENT_ORIGIN=http://localhost:4200
# Session expiry: sign out after this much inactivity, and at most this long after login.
OWNER_IDLE_MINUTES=30
OWNER_MAX_HOURS=12
EMPLOYEE_IDLE_MINUTES=15
EMPLOYEE_MAX_HOURS=12
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Set to 1 when the API runs behind nginx / a load balancer (docker-compose does this).
TRUST_PROXY=
# Platform console (Bizora staff). Sessions are shorter than shop sessions.
PLATFORM_ADMIN_IDLE_MINUTES=15
PLATFORM_ADMIN_MAX_HOURS=8
# Set to 1 before production: every platform admin must enrol an authenticator app before using the console.
PLATFORM_ADMIN_REQUIRE_MFA=
